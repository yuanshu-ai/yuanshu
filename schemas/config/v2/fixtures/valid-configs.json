    "events": { "max_age_hours": 24, "max_size_mib": 256 },
    "workspaces": [
      { "id": "workspace-1", "display_name": "Synthetic workspace", "path": "SYNTHETIC_WORKSPACE_PATH", "allowed_agent_instances": ["codex-default"], "default_agent_instance": "codex-default", "permission_profile": "workspace-write", "allow_network": false }
