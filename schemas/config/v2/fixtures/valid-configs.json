[
  {
    "config_version": 2,
    "host": { "name": "devbox", "locale": "zh-CN" },
    "transport": { "mode": "relay" },
    "relay": { "url": "wss://relay.example.test/node/connect", "proxy_url": "", "ca_bundle_file": "", "connect_timeout_seconds": 15, "credential_ref": "", "proxy_credential_ref": "" },
    "identity": { "key_file": "identity.key" },
