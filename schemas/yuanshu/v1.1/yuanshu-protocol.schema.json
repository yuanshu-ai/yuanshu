{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanshu.ai/schemas/protocol/v1.1/yuanshu-protocol.schema.json",
  "title": "YuanshuMessage",
  "description": "Yuanshu Protocol v1.1 Agent-neutral control and event envelope.",
  "oneOf": [
    { "$ref": "#/$defs/controlMessage" },
    { "$ref": "#/$defs/eventMessage" }
  ],
  "$defs": {
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time" },
    "logicalPath": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "signer": {
      "type": "object", "required": ["clientId", "keyId"],
      "properties": { "clientId": { "$ref": "#/$defs/opaqueId" }, "keyId": { "$ref": "#/$defs/opaqueId" } },
      "additionalProperties": false
    },
    "controlType": {
      "type": "string",
      "enum": [
        "device.sync", "workspace.list", "agent.list", "agent.read",
        "task.list", "task.read", "task.start", "task.resume",
        "run.start", "run.steer", "run.interrupt", "interaction.resolve",
        "events.replay", "snapshot.request", "lease.acquire", "lease.renew",
        "lease.release", "lease.status", "notifications.list", "notifications.read",
        "config.read", "config.update"
      ]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "device.status", "runtime.status", "agent.snapshot", "agent.status",
        "task.snapshot", "task.started", "task.updated",
        "run.started", "run.completed", "run.failed", "run.interrupted",
        "message.delta", "message.completed", "reasoning.summary.delta",
        "reasoning.summary.completed", "plan.updated", "activity.started",
        "activity.updated", "activity.completed", "interaction.requested",
        "interaction.resolved", "file.changed", "diff.updated", "control.result",
        "lease.changed", "history.gap", "error"
      ]
    },
    "controlMessage": {
      "type": "object",
      "required": [
        "protocolVersion", "messageId", "type", "sentAt", "expiresAt", "ownerId",
        "nodeId", "streamId", "sequence", "correlationId", "nonce", "signer", "signature", "payload"
      ],
      "properties": {
        "protocolVersion": { "const": "1.1" },
        "messageId": { "$ref": "#/$defs/opaqueId" },
        "type": { "$ref": "#/$defs/controlType" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "ownerId": { "$ref": "#/$defs/opaqueId" },
        "nodeId": { "$ref": "#/$defs/opaqueId" },
        "agentInstanceId": { "$ref": "#/$defs/opaqueId" },
        "workspaceId": { "$ref": "#/$defs/opaqueId" },
        "taskId": { "$ref": "#/$defs/opaqueId" },
        "runId": { "$ref": "#/$defs/opaqueId" },
        "activityId": { "$ref": "#/$defs/opaqueId" },
        "interactionId": { "$ref": "#/$defs/opaqueId" },
        "streamId": { "$ref": "#/$defs/opaqueId" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "correlationId": { "$ref": "#/$defs/opaqueId" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
        "signer": { "$ref": "#/$defs/signer" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/controlTargetRules" }, { "$ref": "#/$defs/controlPayloadRules" }]
    },
    "eventMessage": {
      "type": "object",
      "required": ["protocolVersion", "messageId", "type", "sentAt", "ownerId", "nodeId", "streamId", "sequence", "correlationId", "payload"],
      "properties": {
        "protocolVersion": { "const": "1.1" },
        "messageId": { "$ref": "#/$defs/opaqueId" },
        "type": { "$ref": "#/$defs/eventType" },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "ownerId": { "$ref": "#/$defs/opaqueId" },
        "nodeId": { "$ref": "#/$defs/opaqueId" },
        "agentInstanceId": { "$ref": "#/$defs/opaqueId" },
        "workspaceId": { "$ref": "#/$defs/opaqueId" },
        "taskId": { "$ref": "#/$defs/opaqueId" },
        "runId": { "$ref": "#/$defs/opaqueId" },
        "activityId": { "$ref": "#/$defs/opaqueId" },
        "interactionId": { "$ref": "#/$defs/opaqueId" },
        "streamId": { "$ref": "#/$defs/opaqueId" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "correlationId": { "$ref": "#/$defs/opaqueId" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/eventPayloadRules" }]
    },
    "controlTargetRules": {
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["agent.read"] } } }, "then": { "properties": { "agentInstanceId": true }, "required": ["agentInstanceId"] } },
        { "if": { "properties": { "type": { "enum": ["task.list", "task.start"] } } }, "then": { "properties": { "agentInstanceId": true, "workspaceId": true }, "required": ["agentInstanceId", "workspaceId"] } },
        { "if": { "properties": { "type": { "enum": ["task.read", "task.resume", "run.start"] } } }, "then": { "properties": { "agentInstanceId": true, "workspaceId": true, "taskId": true }, "required": ["agentInstanceId", "workspaceId", "taskId"] } },
        { "if": { "properties": { "type": { "enum": ["run.steer", "run.interrupt"] } } }, "then": { "properties": { "agentInstanceId": true, "workspaceId": true, "taskId": true, "runId": true }, "required": ["agentInstanceId", "workspaceId", "taskId", "runId"] } },
        { "if": { "properties": { "type": { "const": "interaction.resolve" } } }, "then": { "properties": { "agentInstanceId": true, "workspaceId": true, "taskId": true, "runId": true, "interactionId": true }, "required": ["agentInstanceId", "workspaceId", "taskId", "runId", "interactionId"] } }
      ]
    },
    "emptyPayload": { "type": "object", "additionalProperties": false },
    "listPayload": {
      "type": "object",
      "properties": { "cursor": { "type": "string", "minLength": 1, "maxLength": 512 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 } },
      "additionalProperties": false
    },
    "taskReadPayload": {
      "type": "object",
      "properties": {
        "cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "includeRuns": { "type": "boolean" }, "includeDiffs": { "type": "boolean" },
        "diffPath": { "$ref": "#/$defs/logicalPath" }, "maxDiffBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      },
      "additionalProperties": false
    },
    "textPayload": {
      "type": "object", "required": ["input"],
      "properties": { "input": { "type": "string", "minLength": 1, "maxLength": 65536 } },
      "additionalProperties": false
    },
    "leaseProof": {
      "type": "object", "required": ["leaseId", "epoch"],
      "properties": { "leaseId": { "$ref": "#/$defs/opaqueId" }, "epoch": { "$ref": "#/$defs/sequence" } },
      "additionalProperties": false
    },
    "mutationTextPayload": {
      "type": "object", "required": ["input", "lease"],
      "properties": { "input": { "type": "string", "minLength": 1, "maxLength": 65536 }, "lease": { "$ref": "#/$defs/leaseProof" } },
      "additionalProperties": false
    },
    "mutationPayload": {
      "type": "object", "required": ["lease"],
      "properties": { "lease": { "$ref": "#/$defs/leaseProof" } },
      "additionalProperties": false
    },
    "interactionResolvePayload": {
      "type": "object", "required": ["operationDigest", "lease"],
      "properties": {
        "operationDigest": { "$ref": "#/$defs/digest" },
        "decision": { "type": "string", "enum": ["accept", "decline"] },
        "answer": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "selectedOptionIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/opaqueId" } },
        "lease": { "$ref": "#/$defs/leaseProof" }
      },
      "oneOf": [
        { "properties": { "decision": true }, "required": ["decision"] },
        { "properties": { "answer": true }, "required": ["answer"] },
        { "properties": { "selectedOptionIds": true }, "required": ["selectedOptionIds"] }
      ],
      "additionalProperties": false
    },
    "eventsReplayPayload": {
      "type": "object", "required": ["afterSequence"],
      "properties": { "afterSequence": { "$ref": "#/$defs/sequence" } },
      "additionalProperties": false
    },
    "leaseAcquirePayload": {
      "type": "object",
      "properties": { "force": { "type": "boolean" }, "expectedEpoch": { "$ref": "#/$defs/sequence" } },
      "additionalProperties": false
    },
    "leaseMutationPayload": {
      "type": "object", "required": ["leaseId", "epoch"],
      "properties": { "leaseId": { "$ref": "#/$defs/opaqueId" }, "epoch": { "$ref": "#/$defs/sequence" } },
      "additionalProperties": false
    },
    "notificationReadPayload": {
      "type": "object", "required": ["notificationId"],
      "properties": { "notificationId": { "$ref": "#/$defs/opaqueId" } }, "additionalProperties": false
    },
    "configUpdatePayload": {
      "type": "object", "required": ["baseRevision", "changes"],
      "properties": { "baseRevision": { "$ref": "#/$defs/opaqueId" }, "changes": { "type": "object", "minProperties": 1 } },
      "additionalProperties": false
    },
    "controlPayloadRules": {
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["device.sync", "agent.list", "agent.read", "task.resume", "snapshot.request", "lease.status", "config.read"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/emptyPayload" } } } },
        { "if": { "properties": { "type": { "enum": ["workspace.list", "task.list", "notifications.list"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/listPayload" } } } },
        { "if": { "properties": { "type": { "const": "task.read" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/taskReadPayload" } } } },
        { "if": { "properties": { "type": { "const": "task.start" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/textPayload" } } } },
        { "if": { "properties": { "type": { "enum": ["run.start", "run.steer"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/mutationTextPayload" } } } },
        { "if": { "properties": { "type": { "const": "run.interrupt" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/mutationPayload" } } } },
        { "if": { "properties": { "type": { "const": "interaction.resolve" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/interactionResolvePayload" } } } },
        { "if": { "properties": { "type": { "const": "events.replay" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/eventsReplayPayload" } } } },
        { "if": { "properties": { "type": { "const": "lease.acquire" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/leaseAcquirePayload" } } } },
        { "if": { "properties": { "type": { "enum": ["lease.renew", "lease.release"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/leaseMutationPayload" } } } },
        { "if": { "properties": { "type": { "const": "notifications.read" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/notificationReadPayload" } } } },
        { "if": { "properties": { "type": { "const": "config.update" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/configUpdatePayload" } } } }
      ]
    },
    "capabilityDescriptor": {
      "type": "object", "required": ["id", "level"],
      "properties": { "id": { "$ref": "#/$defs/opaqueId" }, "level": { "type": "string", "enum": ["full", "read-only", "unavailable"] }, "reason": { "type": "string", "maxLength": 256 } },
      "additionalProperties": false
    },
    "agentSummary": {
      "type": "object", "required": ["id", "adapterType", "displayName", "runtimeMode", "status", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" }, "adapterType": { "$ref": "#/$defs/opaqueId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "maxLength": 128 },
        "runtimeMode": { "type": "string", "enum": ["managed", "attached", "history-only", "detected-only"] },
        "status": { "type": "string", "maxLength": 64 }, "providerType": { "type": "string", "maxLength": 64 },
        "customEndpoint": { "type": "boolean" }, "authenticationAvailable": { "type": "boolean" },
        "configurationFingerprint": { "type": "string", "maxLength": 64 },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capabilityDescriptor" } }
      },
      "additionalProperties": false
    },
    "taskSummary": {
      "type": "object", "required": ["id", "agentInstanceId", "workspaceId", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" }, "agentInstanceId": { "$ref": "#/$defs/opaqueId" },
        "workspaceId": { "$ref": "#/$defs/opaqueId" }, "status": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 4096 }, "preview": { "type": "string", "maxLength": 65536 },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" },
        "historyState": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
        "pendingInteractions": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "runSummary": {
      "type": "object", "required": ["id", "status"],
      "properties": { "id": { "$ref": "#/$defs/opaqueId" }, "status": { "type": "string", "maxLength": 64 }, "startedAt": { "$ref": "#/$defs/timestamp" }, "completedAt": { "$ref": "#/$defs/timestamp" } },
      "additionalProperties": false
    },
    "activity": {
      "type": "object", "required": ["id", "kind", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" }, "kind": { "type": "string", "enum": ["command", "tool", "mcp", "web_search", "image", "file_change", "diff", "review", "collaboration", "compaction", "unknown"] },
        "status": { "type": "string", "maxLength": 64 }, "title": { "type": "string", "maxLength": 4096 },
        "text": { "type": "string", "maxLength": 262144 }, "path": { "$ref": "#/$defs/logicalPath" },
        "exitCode": { "type": "integer" }, "truncated": { "type": "boolean" }, "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object", "required": ["id", "kind", "status", "operationDigest", "expiresAt"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" }, "kind": { "type": "string", "enum": ["command_approval", "file_approval", "question", "permission", "mcp_elicitation"] },
        "status": { "type": "string", "enum": ["pending", "processing", "accepted", "declined", "answered", "expired", "ambiguous"] },
        "summary": { "type": "string", "maxLength": 4096 }, "risk": { "type": "string", "enum": ["normal", "high", "unknown"] },
        "operationDigest": { "$ref": "#/$defs/digest" }, "expiresAt": { "$ref": "#/$defs/timestamp" },
        "options": { "type": "array", "maxItems": 32, "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "$ref": "#/$defs/opaqueId" }, "label": { "type": "string", "maxLength": 512 } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "agentSnapshotPayload": {
      "type": "object", "required": ["agents"],
      "properties": { "agents": { "type": "array", "items": { "$ref": "#/$defs/agentSummary" } } }, "additionalProperties": true
    },
    "taskSnapshotPayload": {
      "type": "object",
      "properties": {
        "task": { "$ref": "#/$defs/taskSummary" }, "tasks": { "type": "array", "items": { "$ref": "#/$defs/taskSummary" } },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/runSummary" } },
        "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
        "interactions": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "nextCursor": { "type": "string", "maxLength": 512 }, "latestSequence": { "$ref": "#/$defs/sequence" }
      },
      "anyOf": [
        { "properties": { "task": true }, "required": ["task"] },
        { "properties": { "tasks": true }, "required": ["tasks"] }
      ],
      "additionalProperties": true
    },
    "controlResultPayload": {
      "type": "object", "required": ["status"],
      "properties": { "status": { "type": "string", "enum": ["received", "validated", "dispatching", "confirmed", "rejected", "ambiguous"] }, "errorCode": { "$ref": "#/$defs/errorCode" }, "message": { "type": "string", "maxLength": 4096 } },
      "additionalProperties": true
    },
    "errorCode": {
      "type": "string",
      "enum": ["invalid_message", "unsupported_protocol", "unsupported_control", "unauthorized", "forbidden", "expired", "replay", "not_found", "conflict", "rate_limited", "payload_too_large", "runtime_unavailable", "runtime_failed", "history_gap", "ambiguous", "internal"]
    },
    "eventPayloadRules": {
      "allOf": [
        { "if": { "properties": { "type": { "const": "agent.snapshot" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/agentSnapshotPayload" } } } },
        { "if": { "properties": { "type": { "const": "task.snapshot" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/taskSnapshotPayload" } } } },
        { "if": { "properties": { "type": { "const": "interaction.requested" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/interaction" } } } },
        { "if": { "properties": { "type": { "const": "control.result" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/controlResultPayload" } } } }
      ]
    }
  }
}
