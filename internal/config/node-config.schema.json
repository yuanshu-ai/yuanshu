{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanshu.ai/schemas/config/v1/node-config.schema.json",
  "title": "Yuanshu Node Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "host", "transport", "relay", "identity", "adapters", "events", "workspaces"],
  "properties": {
    "config_version": { "const": 1 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["relay", "standalone"] } }
    },
    "relay": { "$ref": "#/$defs/relay" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_key_ref"],
      "properties": { "private_key_ref": { "$ref": "#/$defs/secretRef" } }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex"],
      "properties": { "codex": { "$ref": "#/$defs/codex" } }
    },
    "events": { "$ref": "#/$defs/events" },
    "workspaces": { "type": "array", "items": { "$ref": "#/$defs/workspace" } }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "properties": { "mode": { "const": "relay" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "relay": { "properties": { "url": { "minLength": 1 } } }
        }
      }
    }
  ],
  "$defs": {
    "secretRef": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1F\\x7F]*$"
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "proxy_url", "connect_timeout_seconds", "credential_ref", "proxy_credential_ref"],
      "properties": {
        "url": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "format": "uri", "pattern": "^wss://" },
            { "type": "string", "format": "uri", "pattern": "^ws://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?(?:/|$)" }
          ]
        },
        "proxy_url": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "format": "uri", "pattern": "^(https?|socks5)://" }
          ]
        },
        "ca_bundle_file": { "type": "string", "maxLength": 4096 },
        "connect_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "credential_ref": { "$ref": "#/$defs/secretRef" },
        "proxy_credential_ref": { "$ref": "#/$defs/secretRef" }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "binary", "runtime_mode", "home"],
      "properties": {
        "enabled": { "type": "boolean" },
        "binary": { "type": "string", "maxLength": 4096 },
        "runtime_mode": { "const": "stdio" },
        "home": { "type": "string", "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "binary": { "minLength": 1 } } }
        }
      ]
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_hours", "max_size_mib"],
      "properties": {
        "max_age_hours": { "type": "integer", "minimum": 1, "maximum": 720 },
        "max_size_mib": { "type": "integer", "minimum": 16, "maximum": 4096 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "path", "allowed_adapters", "default_adapter", "permission_profile", "allow_network"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "allowed_adapters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "codex" }
        },
        "default_adapter": { "const": "codex" },
        "permission_profile": { "enum": ["read-only", "workspace-write"] },
        "allow_network": { "type": "boolean" }
      }
    }
  }
}
