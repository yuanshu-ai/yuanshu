# Independent Web build configuration. These values are public endpoints,
# never credentials or task content.
VITE_YUANSHU_RELAY_URL=wss://relay.example.com/web/connect
VITE_YUANSHU_PAIRING_URL=https://relay.example.com/pair
# Optional runtime configuration: copy public/yuanshu.config.example.json to
# public/yuanshu.config.json for a deployment that should not be rebuilt when
# its Relay IP changes.
